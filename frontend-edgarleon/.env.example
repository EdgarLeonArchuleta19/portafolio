# Desarrollo: lee Strapi en vivo. Déjala vacía (o bórrala) para usar src/data/content.json,
# que es lo que hace el sitio publicado en Vercel.
VITE_STRAPI_URL=http://localhost:1337

# Opcional y NO recomendado: todo lo que empieza con VITE_ queda público en el bundle.
# El backend ya da permisos de lectura al rol Public, así que no hace falta token.
# VITE_STRAPI_TOKEN=
